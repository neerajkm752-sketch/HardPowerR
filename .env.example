# Server
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/hard-power-index

# Optional paid / BYOK providers. If none are set, the API uses a free
# public text model (Pollinations) so Ask the Index AI still answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Browser-visible API base; omit to use the local Next.js proxy
NEXT_PUBLIC_API_URL=
